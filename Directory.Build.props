<Project>
  <PropertyGroup>
    <RequiredMsvcToolsVersion>14.52</RequiredMsvcToolsVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'!='Release'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <RedTildeBuildNumber Condition="'$(RedTildeBuildNumber)'==''">0</RedTildeBuildNumber>
    <RedTildeEnableTests Condition="'$(RedTildeEnableTests)'==''">true</RedTildeEnableTests>
    <RedTildeBuildRoot>$(MSBuildThisFileDirectory).build\</RedTildeBuildRoot>
    <RedTildeOutputRoot Condition="'$(RedTildeOutputRoot)'==''">$(RedTildeBuildRoot)</RedTildeOutputRoot>
    <OutDir>$(RedTildeOutputRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RedTildeOutputRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <RedTildeVcpkgPlatformScope Condition="'$(Platform)'=='ARM64'">arm64</RedTildeVcpkgPlatformScope>
    <RedTildeVcpkgPlatformScope Condition="'$(Platform)'=='x64' and '$(Configuration)'=='ASan Debug'">x64-asan</RedTildeVcpkgPlatformScope>
    <RedTildeVcpkgPlatformScope Condition="'$(Platform)'=='ARM64' and '$(Configuration)'=='ASan Debug'">arm64-asan</RedTildeVcpkgPlatformScope>
    <RedTildeVcpkgPlatformScope Condition="'$(RedTildeVcpkgPlatformScope)'==''">x64</RedTildeVcpkgPlatformScope>
    <RedTildeVcpkgTriplet Condition="'$(Platform)'=='ARM64'">arm64-windows-static-md</RedTildeVcpkgTriplet>
    <RedTildeVcpkgTriplet Condition="'$(Platform)'=='x64' and '$(Configuration)'=='ASan Debug'">x64-windows-static-md-asan</RedTildeVcpkgTriplet>
    <RedTildeVcpkgTriplet Condition="'$(Platform)'=='ARM64' and '$(Configuration)'=='ASan Debug'">arm64-windows-static-md-asan</RedTildeVcpkgTriplet>
    <RedTildeVcpkgTriplet Condition="'$(RedTildeVcpkgTriplet)'==''">x64-windows-static-md</RedTildeVcpkgTriplet>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(RedTildeBuildRoot)vcpkg_installed\$(RedTildeVcpkgPlatformScope)\</VcpkgInstalledDir>
    <VcpkgEnabled>false</VcpkgEnabled>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'!='Debug'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>EnableAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /permissive- /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;REDTILDE_BUILD_NUMBER=$(RedTildeBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(RedTildeEnableTests)'=='true'">REDTILDE_ENABLE_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <RuntimeLibrary Condition="'$(Configuration)'!='Release'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'!='Release'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>REDTILDE_BUILD_NUMBER=$(RedTildeBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link><GenerateDebugInformation>true</GenerateDebugInformation></Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(Configuration)'=='ASan Debug'">
    <EnableASAN>true</EnableASAN>
    <CopyAsanBinariesToOutDir>true</CopyAsanBinariesToOutDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and ('$(Configuration)'=='Debug' or '$(Configuration)'=='ASan Debug')">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedTildeVcpkgTriplet)\debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <Link>
      <AdditionalLibraryDirectories>$(VcpkgInstalledDir)$(RedTildeVcpkgTriplet)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

<Import Project="$(MSBuildThisFileDirectory)Build\RedMonitor.props" />
</Project>
