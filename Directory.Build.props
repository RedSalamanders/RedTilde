<Project>
  <PropertyGroup>
    <RequiredMsvcToolsVersion>14.52</RequiredMsvcToolsVersion>
    <RedTildeBuildNumber Condition="'$(RedTildeBuildNumber)'==''">0</RedTildeBuildNumber>
    <RedTildeEnableTests Condition="'$(RedTildeEnableTests)'==''">true</RedTildeEnableTests>
    <RedTildeOutputRoot Condition="'$(RedTildeOutputRoot)'==''">$(MSBuildThisFileDirectory).build\</RedTildeOutputRoot>
    <OutDir>$(RedTildeOutputRoot)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RedTildeOutputRoot)obj\$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <VcpkgEnabled>false</VcpkgEnabled>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'!='Debug'">false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <WarningLevel>EnableAllWarnings</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 /permissive- /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(RedTildeEnableTests)'=='true'">REDTILDE_ENABLE_TESTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>REDTILDE_BUILD_NUMBER=$(RedTildeBuildNumber);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Link><GenerateDebugInformation>true</GenerateDebugInformation></Link>
  </ItemDefinitionGroup>
  <PropertyGroup Condition="'$(Configuration)'=='ASan Debug'">
    <EnableASAN>true</EnableASAN>
    <CopyAsanBinariesToOutDir>true</CopyAsanBinariesToOutDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

<Import Project="$(MSBuildThisFileDirectory)Build\RedMonitor.props" />
  <ItemDefinitionGroup><ClCompile><AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile></ItemDefinitionGroup>
</Project>
