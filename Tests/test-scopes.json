{
  "version": 2,
  "defaultBranch": "main",
  "buildNumber": "none",
  "nativeInventory": {
    "path": "Tests/NativeInventory.json",
    "exclude": [
      "Specs/**",
      "Measurements/**",
      "legacy/**",
      "ThirdParty/**"
    ],
    "testFolders": [
      "Tests/**"
    ]
  },
  "runtimeFiles": [],
  "prose": [
    "README.md",
    "CHANGELOG.md",
    "**/AGENTS.md",
    "docs/**/*.md",
    "Specs/**/*.md",
    ".agents/**/*.md",
    "Changes/**/*.md"
  ],
  "unscoped": [
    "legacy/**",
    "docs/**",
    "Measurements/**",
    "Mockups/**"
  ],
  "scopes": [
    {
      "name": "Storage",
      "native": true,
      "reuse": true
    },
    {
      "name": "Settings",
      "native": true,
      "reuse": true
    },
    {
      "name": "Recovery",
      "native": true,
      "reuse": true
    },
    {
      "name": "Editor",
      "native": true,
      "reuse": false
    },
    {
      "name": "Preferences",
      "native": true,
      "reuse": true
    },
    {
      "name": "RecoveryRestart",
      "native": true,
      "reuse": false
    },
    {
      "name": "Performance",
      "native": true,
      "reuse": false
    },
    {
      "name": "Captures",
      "native": true,
      "reuse": false
    },
    {
      "name": "Crash",
      "native": true,
      "reuse": false
    },
    {
      "name": "Sanitizer",
      "native": true,
      "reuse": false,
      "configurations": [
        "ASan Debug"
      ]
    },
    {
      "name": "Tooling",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "validate.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "validate-skills.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "Tools/Test-AgentGuidance.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "docs/examples/**/*.md",
      "scopes": [
        "*"
      ],
      "reason": "shipped Markdown examples and paired-performance runtime fixtures"
    },
    {
      "pattern": "docs/examples/**",
      "scopes": [
        "*"
      ],
      "reason": "shipped package examples and paired-performance runtime fixtures"
    },
    {
      "pattern": "Tests/Fixtures/reference-dark.md",
      "scopes": [
        "Captures",
        "Tooling",
        "Format"
      ],
      "reason": "runtime source fixture for reference-dark DPI captures"
    },
    {
      "pattern": "Common/Files.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded folder service and UI owner adoption"
    },
    {
      "pattern": "Common/RemoteImage.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded anonymous image transport and editor policy adoption"
    },
    {
      "pattern": "Tests/Application.Tests.Close.*",
      "scopes": [
        "Recovery",
        "Editor"
      ],
      "reason": "real file-worker admission, asynchronous shutdown, recovery retention, stale Open refusal and source-bound editor save commands"
    },
    {
      "pattern": "Tests/Application.Tests.Files.*",
      "scopes": [
        "Storage",
        "Settings",
        "Editor"
      ],
      "reason": "Files, versioned preferences and revision-bound document-position registration units"
    },
    {
      "pattern": "Tests/Application.Tests.DesignRefresh.*",
      "scopes": [
        "Editor"
      ],
      "reason": "hidden design refresh behavior and native presentation"
    },
    {
      "pattern": "Tests/Application.Tests.DesignInteractive.*",
      "scopes": [
        "Editor",
        "Tooling"
      ],
      "reason": "interactive child fail-closed guard; authorized real desktop gate stays separate"
    },
    {
      "pattern": "Tests/Application.Tests.RemoteImages.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "loopback transport and live remote-image policy regressions"
    },
    {
      "pattern": "Tests/Application.Tests.Settings.*",
      "scopes": [
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "JSON5 settings store, legacy migration, and live SettingsWatcher regressions"
    },
    {
      "pattern": "Tests/Application.Tests.Panes.*",
      "scopes": [
        "Editor"
      ],
      "reason": "right panel toggle parity, responsive auto-collapse rails, animations, and dot navigation"
    },
    {
      "pattern": "Tests/Application.Tests.SplitEditing.*",
      "scopes": [
        "Settings",
        "Editor"
      ],
      "reason": "bidirectional Split editing, linked scroll sync, active-view Find, and splitScrollSync settings"
    },
    {
      "pattern": "SettingsStore.schema.json",
      "scopes": [
        "Settings",
        "Tooling"
      ],
      "reason": "shipped settings store schema"
    },
    {
      "pattern": "vcpkg*",
      "scopes": [
        "*"
      ],
      "reason": "pinned vcpkg manifest, toolchain pin, and restore entry point"
    },
    {
      "pattern": "Tests/Support/Support.Tests.FilesFixtures.h",
      "scopes": [
        "Storage",
        "Editor",
        "Captures"
      ],
      "reason": "shared invented folder fixtures and bounded reparse leaves"
    },
    {
      "pattern": "Tests/Support/Support.Tests.StorageSafety.h",
      "scopes": [
        "Storage",
        "Recovery",
        "Tooling"
      ],
      "reason": "directed storage checkpoints and reviewed native storage case registrations"
    },
    {
      "pattern": "Tests/README.md",
      "scopes": [
        "Tooling"
      ],
      "reason": "test workflow documentation"
    },
    {
      "pattern": "test-interactive.ps1",
      "scopes": [
        "*"
      ],
      "reason": "source-bound artifact preflight and canonical desktop lease runner"
    },
    {
      "pattern": "Common/Storage.cpp",
      "scopes": [
        "Storage",
        "Recovery",
        "RecoveryRestart"
      ],
      "reason": "Unicode and atomic storage; recovery serialization and process restart consumers"
    },
    {
      "pattern": "Common/Settings.cpp",
      "scopes": [
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "settings model, durable process exit and live editor appearance"
    },
    {
      "pattern": "Common/Recovery.cpp",
      "scopes": [
        "Recovery",
        "RecoveryRestart",
        "Editor"
      ],
      "reason": "recovery envelopes, process restart and editor draft/offer integration"
    },
    {
      "pattern": "Common/DocumentInfo.cpp",
      "scopes": [
        "Editor"
      ],
      "reason": "document-derived outline and editor integration"
    },
    {
      "pattern": "Common/CrashHandler.cpp",
      "scopes": [
        "*"
      ],
      "reason": "crash installation is shared process bootstrap"
    },
    {
      "pattern": "Common/Storage.h",
      "scopes": [
        "Storage",
        "Recovery",
        "RecoveryRestart"
      ],
      "reason": "Unicode and atomic storage; recovery serialization and process restart consumers"
    },
    {
      "pattern": "Common/Settings.h",
      "scopes": [
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "settings model, durable process exit and live editor appearance"
    },
    {
      "pattern": "Common/Recovery.h",
      "scopes": [
        "Recovery",
        "RecoveryRestart",
        "Editor"
      ],
      "reason": "recovery envelopes, process restart and editor draft/offer integration"
    },
    {
      "pattern": "Common/DocumentInfo.h",
      "scopes": [
        "Editor"
      ],
      "reason": "document-derived outline and editor integration"
    },
    {
      "pattern": "Common/CrashHandler.h",
      "scopes": [
        "*"
      ],
      "reason": "crash installation is shared process bootstrap"
    },
    {
      "pattern": "RedTilde/**",
      "scopes": [
        "*"
      ],
      "reason": "application ownership, shared bootstrap, native command routing and presentation"
    },
    {
      "pattern": "res/**",
      "scopes": [
        "*"
      ],
      "reason": "embedded chrome, product resources and capture inputs"
    },
    {
      "pattern": "Tests/Application.Tests.Core.cpp",
      "scopes": [
        "Storage",
        "Settings",
        "Recovery",
        "Editor",
        "Tooling"
      ],
      "reason": "native behavioral dispatcher and reviewed case partition"
    },
    {
      "pattern": "Tests/Application.Tests.Performance.cpp",
      "scopes": [
        "Editor",
        "Performance",
        "Tooling"
      ],
      "reason": "native completed-frame/resource functions are called by Editor cases and the measurement smoke"
    },
    {
      "pattern": "Tests/*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent numerical/evidence/tooling regressions"
    },
    {
      "pattern": "Tools/Test-RealLocations.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "opt-in fail-closed real-location harness (never auto-run in default/CI suites)"
    },
    {
      "pattern": "Tests/Tooling.Tests.RealLocations.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "compiler-free fail-closed real-location contract gate"
    },
    {
      "pattern": "Tests/Tooling.Tests.PiiHygiene.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "compiler-free repository PII hygiene check"
    },
    {
      "pattern": "Tests/NativeInventory.json",
      "scopes": [
        "Tooling"
      ],
      "reason": "native file membership and scenario inventory"
    },
    {
      "pattern": "Tests/native-case-catalog.json",
      "scopes": [
        "Storage",
        "Settings",
        "Recovery",
        "Editor",
        "Tooling"
      ],
      "reason": "source/list/execution union must equal the reviewed case partition"
    },
    {
      "pattern": "**/*.cpp",
      "scopes": [
        "Format"
      ],
      "reason": "native source formatting",
      "additive": true
    },
    {
      "pattern": "**/*.h",
      "scopes": [
        "Format"
      ],
      "reason": "native header formatting",
      "additive": true
    },
    {
      "pattern": ".clang-format",
      "scopes": [
        "Format"
      ],
      "reason": "formatter policy"
    },
    {
      "pattern": ".clang-tidy",
      "scopes": [
        "Tooling"
      ],
      "reason": "naming and reserved-identifier linter policy"
    },
    {
      "pattern": ".agents/**",
      "scopes": [
        "Tooling"
      ],
      "reason": "repository guidance validation"
    },
    {
      "pattern": "validate*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent validators"
    },
    {
      "pattern": "format.ps1",
      "scopes": [
        "Format",
        "Tooling"
      ],
      "reason": "formatter and discovery contract"
    },
    {
      "pattern": "Tests/Tooling.Tests.ScopedTesting.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "scope-selection/evidence/iteration/public-entrypoint regressions"
    },
    {
      "pattern": "Build/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Dependencies/**",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Directory.Build.*",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.vcxproj",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "*.sln",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "test.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "build.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "package.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "current build-receipt admission before packaging"
    },
    {
      "pattern": "Installer/**",
      "scopes": [
        "Tooling"
      ],
      "reason": "per-user installer PowerShell syntax and contract validation"
    },
    {
      "pattern": "performance-paired.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "current build-receipt admission before performance runs"
    },
    {
      "pattern": "restore-dxui.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Test-Changes.ps1",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    },
    {
      "pattern": "Tests/test-scopes.json",
      "scopes": [
        "*"
      ],
      "reason": "shared build, dependency, runner or scope policy"
    }
  ],
  "interactiveObligations": [
    {
      "pattern": "**",
      "suites": [
        "DesignInteractive"
      ],
      "reason": "run test-interactive.ps1 for physical keyboard and focus after desktop admission"
    }
  ],
  "watchedProcesses": [
    "RedTilde.exe",
    "DxUi.ControlTests.exe",
    "DxUi.EmbeddedTests.exe",
    "DxUi.FoundationTests.exe",
    "DxUi.InteractiveLease.exe"
  ],
  "prePushProfiles": [
    {
      "platform": "x64",
      "configuration": "Debug",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "Release",
      "buildOnly": false
    },
    {
      "platform": "x64",
      "configuration": "ASan Debug",
      "buildOnly": false
    },
    {
      "platform": "ARM64",
      "configuration": "Debug",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "Release",
      "buildOnly": true
    },
    {
      "platform": "ARM64",
      "configuration": "ASan Debug",
      "buildOnly": true
    }
  ],
  "instrumentationVariables": [
    "ASAN_OPTIONS"
  ],
  "systemFiles": [
    "d2d1.dll",
    "d3d10warp.dll",
    "d3d11.dll",
    "dwrite.dll",
    "dxgi.dll",
    "windowscodecs.dll"
  ]
}
