{
  "version": 1,
  "project": "RedTilde",
  "repository": "RedSalamanders/RedTilde",
  "defaultBranch": "main",
  "nativeInventory": "Tests/NativeInventory.json",
  "runtimeFiles": [],
  "scopes": [
    {
      "name": "Storage",
      "native": true,
      "reuse": true
    },
    {
      "name": "Settings",
      "native": true,
      "reuse": true
    },
    {
      "name": "Recovery",
      "native": true,
      "reuse": true
    },
    {
      "name": "Editor",
      "native": true,
      "reuse": false
    },
    {
      "name": "Preferences",
      "native": true,
      "reuse": true
    },
    {
      "name": "RecoveryRestart",
      "native": true,
      "reuse": false
    },
    {
      "name": "Performance",
      "native": true,
      "reuse": false
    },
    {
      "name": "Captures",
      "native": true,
      "reuse": false
    },
    {
      "name": "Crash",
      "native": true,
      "reuse": false
    },
    {
      "name": "Sanitizer",
      "native": true,
      "reuse": false,
      "configurations": [
        "ASan Debug"
      ]
    },
    {
      "name": "Tooling",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "validate.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "Tests/Fixtures/reference-dark.md",
      "scopes": [
        "Captures",
        "Tooling",
        "Format"
      ],
      "reason": "runtime source fixture for reference-dark DPI captures"
    },
    {
      "pattern": "Common/Files.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded folder service and UI owner adoption"
    },
    {
      "pattern": "Common/RemoteImage.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded anonymous image transport and editor policy adoption"
    },
    {
      "pattern": "Tests/Application.Tests.Files.*",
      "scopes": [
        "Storage",
        "Settings",
        "Editor"
      ],
      "reason": "Files, versioned preferences and revision-bound document-position registration units"
    },
    {
      "pattern": "Tests/Application.Tests.DesignRefresh.*",
      "scopes": [
        "Editor"
      ],
      "reason": "hidden design refresh behavior and native presentation"
    },
    {
      "pattern": "Tests/Application.Tests.DesignInteractive.*",
      "scopes": [
        "Editor",
        "Tooling"
      ],
      "reason": "interactive child fail-closed guard; authorized real desktop gate stays separate"
    },
    {
      "pattern": "Tests/Application.Tests.RemoteImages.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "loopback transport and live remote-image policy regressions"
    },
    {
      "pattern": "Tests/Support/Support.Tests.FilesFixtures.h",
      "scopes": [
        "Storage",
        "Editor",
        "Captures"
      ],
      "reason": "shared invented folder fixtures and bounded reparse leaves"
    },
    {
      "pattern": "Tests/README.md",
      "scopes": [
        "Tooling"
      ],
      "reason": "test workflow documentation"
    },
    {
      "pattern": "test-interactive.ps1",
      "scopes": [
        "*"
      ],
      "reason": "source-bound artifact preflight and canonical desktop lease runner"
    },
    {
      "pattern": "Common/Storage.cpp",
      "scopes": [
        "Storage",
        "Recovery",
        "RecoveryRestart"
      ],
      "reason": "Unicode and atomic storage; recovery serialization and process restart consumers"
    },
    {
      "pattern": "Common/Settings.cpp",
      "scopes": [
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "settings model, durable process exit and live editor appearance"
    },
    {
      "pattern": "Common/Recovery.cpp",
      "scopes": [
        "Recovery",
        "RecoveryRestart",
        "Editor"
      ],
      "reason": "recovery envelopes, process restart and editor draft/offer integration"
    },
    {
      "pattern": "Common/DocumentInfo.cpp",
      "scopes": [
        "Editor"
      ],
      "reason": "document-derived outline and editor integration"
    },
    {
      "pattern": "Common/CrashHandler.cpp",
      "scopes": [
        "*"
      ],
      "reason": "crash installation is shared process bootstrap"
    },
    {
      "pattern": "Common/Storage.h",
      "scopes": [
        "Storage",
        "Recovery",
        "RecoveryRestart"
      ],
      "reason": "Unicode and atomic storage; recovery serialization and process restart consumers"
    },
    {
      "pattern": "Common/Settings.h",
      "scopes": [
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "settings model, durable process exit and live editor appearance"
    },
    {
      "pattern": "Common/Recovery.h",
      "scopes": [
        "Recovery",
        "RecoveryRestart",
        "Editor"
      ],
      "reason": "recovery envelopes, process restart and editor draft/offer integration"
    },
    {
      "pattern": "Common/DocumentInfo.h",
      "scopes": [
        "Editor"
      ],
      "reason": "document-derived outline and editor integration"
    },
    {
      "pattern": "Common/CrashHandler.h",
      "scopes": [
        "*"
      ],
      "reason": "crash installation is shared process bootstrap"
    },
    {
      "pattern": "RedTilde/**",
      "scopes": [
        "*"
      ],
      "reason": "application ownership, shared bootstrap, native command routing and presentation"
    },
    {
      "pattern": "res/**",
      "scopes": [
        "*"
      ],
      "reason": "embedded chrome, product resources and capture inputs"
    },
    {
      "pattern": "Tests/Application.Tests.Core.cpp",
      "scopes": [
        "Storage",
        "Settings",
        "Recovery",
        "Editor",
        "Tooling"
      ],
      "reason": "native behavioral dispatcher and reviewed case partition"
    },
    {
      "pattern": "Tests/Application.Tests.Performance.cpp",
      "scopes": [
        "Editor",
        "Performance",
        "Tooling"
      ],
      "reason": "native completed-frame/resource functions are called by Editor cases and the measurement smoke"
    },
    {
      "pattern": "Tests/*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent numerical/evidence/tooling regressions"
    },
    {
      "pattern": "Tests/NativeInventory.json",
      "scopes": [
        "Tooling"
      ],
      "reason": "native file membership and scenario inventory"
    },
    {
      "pattern": "Tests/native-case-catalog.json",
      "scopes": [
        "Storage",
        "Settings",
        "Recovery",
        "Editor",
        "Tooling"
      ],
      "reason": "source/list/execution union must equal the reviewed case partition"
    },
    {
      "pattern": "**/*.cpp",
      "scopes": [
        "Format"
      ],
      "reason": "native source formatting"
    },
    {
      "pattern": "**/*.h",
      "scopes": [
        "Format"
      ],
      "reason": "native header formatting"
    },
    {
      "pattern": ".clang-format",
      "scopes": [
