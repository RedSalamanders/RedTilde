{
  "version": 2,
  "defaultBranch": "main",
  "buildNumber": "none",
  "nativeInventory": {
    "path": "Tests/NativeInventory.json",
    "exclude": [
      "Specs/**",
      "Measurements/**",
      "legacy/**",
      "ThirdParty/**"
    ],
    "testFolders": [
      "Tests/**"
    ]
  },
  "runtimeFiles": [],
  "prose": [
    "README.md",
    "CHANGELOG.md",
    "**/AGENTS.md",
    "docs/**/*.md",
    "Specs/**/*.md",
    ".agents/**/*.md",
    "Changes/**/*.md"
  ],
  "unscoped": [
    "legacy/**",
    "docs/**",
    "Measurements/**",
    "Mockups/**"
  ],
  "scopes": [
    {
      "name": "Storage",
      "native": true,
      "reuse": true
    },
    {
      "name": "Settings",
      "native": true,
      "reuse": true
    },
    {
      "name": "Recovery",
      "native": true,
      "reuse": true
    },
    {
      "name": "Editor",
      "native": true,
      "reuse": false
    },
    {
      "name": "Preferences",
      "native": true,
      "reuse": true
    },
    {
      "name": "RecoveryRestart",
      "native": true,
      "reuse": false
    },
    {
      "name": "Performance",
      "native": true,
      "reuse": false
    },
    {
      "name": "Captures",
      "native": true,
      "reuse": false
    },
    {
      "name": "Crash",
      "native": true,
      "reuse": false
    },
    {
      "name": "Sanitizer",
      "native": true,
      "reuse": false,
      "configurations": [
        "ASan Debug"
      ]
    },
    {
      "name": "Tooling",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "validate.ps1",
          "arguments": []
        }
      ]
    },
    {
      "name": "Format",
      "native": false,
      "reuse": true,
      "commands": [
        {
          "path": "format.ps1",
          "arguments": [
            "-Check"
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "pattern": "validate-skills.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "Tools/Test-AgentGuidance.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent agent guidance validation",
      "exclusive": true
    },
    {
      "pattern": "docs/examples/**/*.md",
      "scopes": [
        "*"
      ],
      "reason": "shipped Markdown examples and paired-performance runtime fixtures"
    },
    {
      "pattern": "docs/examples/**",
      "scopes": [
        "*"
      ],
      "reason": "shipped package examples and paired-performance runtime fixtures"
    },
    {
      "pattern": "Tests/Fixtures/reference-dark.md",
      "scopes": [
        "Captures",
        "Tooling",
        "Format"
      ],
      "reason": "runtime source fixture for reference-dark DPI captures"
    },
    {
      "pattern": "Common/Files.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded folder service and UI owner adoption"
    },
    {
      "pattern": "Common/RemoteImage.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded anonymous image transport and editor policy adoption"
    },
    {
      "pattern": "Common/BitmapAssets.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "bounded asset storage and bitmap paste persistence"
    },
    {
      "pattern": "Common/CredentialStore.*",
      "scopes": [
        "Editor"
      ],
      "reason": "Windows Credential Manager store and secret scrubbing"
    },
    {
      "pattern": "Common/CustomDictionary.*",
      "scopes": [
        "Settings",
        "Editor"
      ],
      "reason": "custom dictionary encoding, atomic storage, and normalization"
    },
    {
      "pattern": "Common/DirectoryWatch.h",
      "scopes": [
        "Storage",
        "Settings",
        "Preferences",
        "Editor"
      ],
      "reason": "shared ReadDirectoryChangesW watcher for settings, files, and images"
    },
    {
      "pattern": "Common/DxUiFailureHost.*",
      "scopes": [
        "*"
      ],
      "reason": "host-owned failure and worker admission lifetime"
    },
    {
      "pattern": "Common/FileOps.*",
      "scopes": [
        "Storage",
        "Editor"
      ],
      "reason": "workspace file rename, copy, paste, and path safety"
    },
    {
      "pattern": "Common/GitHubClient.*",
