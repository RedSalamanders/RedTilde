      ],
      "reason": "repository guidance validation"
    },
    {
      "pattern": "validate*.ps1",
      "scopes": [
        "Tooling"
      ],
      "reason": "independent validators"
    },
    {
      "pattern": "format.ps1",
      "scopes": [
        "Format",
