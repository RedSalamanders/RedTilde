<Project>
  <Target Name="ValidateRedTildeOutputRoot" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_RedTildeCanonicalOutputRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory).build\'))</_RedTildeCanonicalOutputRoot>
      <_RedTildeEvaluatedOutputRoot>$([System.IO.Path]::GetFullPath('$(RedTildeOutputRoot)'))</_RedTildeEvaluatedOutputRoot>
    </PropertyGroup>
    <Error Condition="'$(_RedTildeEvaluatedOutputRoot)'!='$(_RedTildeCanonicalOutputRoot)' and ('$(CiSdkContract)'!='LocalUnpinnedAbiV1' or '$(RedTildeDxUiSdkRoot)'=='' or '$(RedTildeCiEngineRoot)'=='')" Text="Separate RedTilde output roots require the explicit local SDK build broker and its active compiler lease." />
    <CallTarget Targets="CiRequireSdkConsumerLease" Condition="'$(_RedTildeEvaluatedOutputRoot)'!='$(_RedTildeCanonicalOutputRoot)'" />
  </Target>
  <PropertyGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectExtension)'=='.vcxproj' and '$(Configuration)'=='Release'">
    <ClCompile>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
    <Lib><LinkTimeCodeGeneration>true</LinkTimeCodeGeneration></Lib>
  </ItemDefinitionGroup>
  <Target Name="ValidateMsvcToolsVersion" BeforeTargets="PrepareForBuild" Condition="'$(MSBuildProjectExtension)'=='.vcxproj'">
    <Error Condition="!$([System.String]::Copy('$(VCToolsVersion)').StartsWith('$(RequiredMsvcToolsVersion).'))" Text="This project requires MSVC build tools $(RequiredMsvcToolsVersion).x; selected $(VCToolsVersion). Install and select the required default C++ toolset." />
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)Build/NativeBuildPolicy.targets" />
</Project>
