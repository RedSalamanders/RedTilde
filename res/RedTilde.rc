#include <windows.h>
#include "Resource.h"
IDI_REDTILDE ICON "RedTilde.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "RedSalamanders\0"
      VALUE "FileDescription", "RedTilde Markdown editor\0"
      VALUE "FileVersion", "0.1.0\0"
      VALUE "InternalName", "RedTilde\0"
      VALUE "OriginalFilename", "RedTilde.exe\0"
      VALUE "ProductName", "RedTilde\0"
      VALUE "ProductVersion", "0.1.0 experimental\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
